#!/bin/bash

# Claude Router — starts claude-code-proxy and launches Claude Code
#
# Usage:
#   claudeRouter [args...]                     → normal mode (reuses existing proxy)
#   claudeRouter --swarm                       → swarm mode (claude-swarm on host)
#   claudeRouter --swarm --off                 → stop proxy
#   claudeRouter --swarm --status              → show proxy status

PROXY_DIR="/Users/inutayfi/Desktop/LLMs/claude-code-proxy"
CLOUDE_FLOW_DIR="/Users/inutayfi/Desktop/LLMs/claude-flow"
PROXY_PORT=18765
ZAI_ENV_FILE="$HOME/.config/claude-router/.env"

# Initialize rbenv if available (needed for claude-swarm)
if [ -d "$HOME/.rbenv/shims" ]; then
  export PATH="$HOME/.rbenv/shims:$PATH"
  eval "$(rbenv init - bash 2>/dev/null)" || true
fi

# ── Parse flags ──
SWARM_MODE=false
SWARM_OFF=false
SWARM_STATUS=false
CLAUDE_ARGS=()
for arg in "$@"; do
  case "$arg" in
    --swarm)   SWARM_MODE=true ;;
    --off)     SWARM_OFF=true ;;
    --status)  SWARM_STATUS=true ;;
    *)         CLAUDE_ARGS+=("$arg") ;;
  esac
done

# ── Load ZAI key if available ──
ZAI_API_KEY=""
if [ -f "$ZAI_ENV_FILE" ]; then
  ZAI_API_KEY=$(grep '^ZAI_API_KEY=' "$ZAI_ENV_FILE" 2>/dev/null | cut -d= -f2-)
fi

# ═══════════════════════════════════════════════════════════════
# SWARM STATUS
# ═══════════════════════════════════════════════════════════════
if [ "$SWARM_STATUS" = true ]; then
  echo "┌─────────────────────────────┐"
  echo "│        Swarm Status         │"
  echo "├─────────────────────────────┤"

  if lsof -i:$PROXY_PORT >/dev/null 2>&1; then
    PID=$(lsof -t -i:$PROXY_PORT 2>/dev/null)
    echo "│ Proxy:  RUNNING (PID $PID)  │"
  else
    echo "│ Proxy:  STOPPED             │"
  fi

  echo "└─────────────────────────────┘"
  exit 0
fi

# ═══════════════════════════════════════════════════════════════
# SWARM OFF
# ═══════════════════════════════════════════════════════════════
if [ "$SWARM_OFF" = true ]; then
  echo "Stopping swarm..."
  kill -9 $(lsof -t -i:$PROXY_PORT 2>/dev/null) 2>/dev/null
  echo "Swarm stopped."
  exit 0
fi

# ═══════════════════════════════════════════════════════════════
# HELPER: start proxy if not already running
# ═══════════════════════════════════════════════════════════════
ensure_proxy() {
  if lsof -i:$PROXY_PORT >/dev/null 2>&1; then
    echo "Proxy already running on port $PROXY_PORT (reusing)"
    return 0
  fi

  (
    cd "$PROXY_DIR" || exit 1
    unset ANTHROPIC_API_KEY 2>/dev/null
    unset ANTHROPIC_AUTH_TOKEN 2>/dev/null
    export ZAI_API_KEY="$ZAI_API_KEY"
    export CCP_ALIAS_PROVIDER="codex"
    export CCP_CODEX_TRANSPORT="${CCP_CODEX_TRANSPORT:-auto}"
    cargo run --release -- serve >/dev/null 2>&1 &
  )

  echo -n "Starting proxy"
  for i in {1..20}; do
    if lsof -i:$PROXY_PORT >/dev/null 2>&1; then
      echo " ✓"
      return 0
    fi
    echo -n "."
    sleep 0.25
  done
  echo " ✗ (timeout)"
  return 1
}

# ═══════════════════════════════════════════════════════════════
# SWARM ON (host-based, no Docker)
# ═══════════════════════════════════════════════════════════════
if [ "$SWARM_MODE" = true ]; then
  echo "Starting swarm session..."

  # Start proxy (reuse if already running)
  ensure_proxy || exit 1

  # ── Resolve which claude-swarm.yml to use ──
  # Use the caller's directory if it has a claude-swarm.yml, else fall back to Cloude-flow
  CALLER_DIR="$(pwd)"
  if [ -f "$CALLER_DIR/claude-swarm.yml" ]; then
    SWARM_CONFIG="$CALLER_DIR/claude-swarm.yml"
    echo "📋 Using local config: $SWARM_CONFIG"
  else
    SWARM_CONFIG="$CLOUDE_FLOW_DIR/claude-swarm.yml"
    echo "📋 Using default config: $SWARM_CONFIG"
  fi

  # Use absolute paths so we can stay in the caller's working directory
  export BUNDLE_GEMFILE="$CLOUDE_FLOW_DIR/claude-swarm/Gemfile"
  SWARM_EXE="$CLOUDE_FLOW_DIR/claude-swarm/exe/claude-swarm"

  # Auto-install gems if missing (self-healing — runs once, cached after that)
  if ! rbenv exec bundle check --quiet 2>/dev/null; then
    echo "⚙️  Installing missing gems (one-time setup)..."
    rbenv exec bundle install --quiet || { echo "✗ bundle install failed"; exit 1; }
    echo "✓ Gems ready"
  fi

  # Run from the caller's directory — agents will see this as their working dir
  cd "$CALLER_DIR"
  echo "📂 Working directory: $CALLER_DIR"
  echo "Launching claude-swarm (press Ctrl+D or type /exit to quit)..."
  cd "$CLOUDE_FLOW_DIR/claude-swarm" || exit 1
  unset ANTHROPIC_MODEL 2>/dev/null
  export ANTHROPIC_BASE_URL="http://localhost:$PROXY_PORT"
  export ANTHROPIC_SMALL_FAST_MODEL="${ANTHROPIC_SMALL_FAST_MODEL:-haiku}"
  export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="1"
  bundle exec claude-swarm

  echo "Swarm session ended."
  exit 0
fi

# ═══════════════════════════════════════════════════════════════
# NORMAL MODE (supports multiple concurrent terminals)
# ═══════════════════════════════════════════════════════════════

# Reuse existing proxy — allows multiple terminals
ensure_proxy || exit 1

# Launch Claude Code from original directory
ORIGINAL_DIR="$(pwd)"
cd "$ORIGINAL_DIR"

# Clean any leaked auth vars so Claude Code uses its stored OAuth only
unset ANTHROPIC_API_KEY 2>/dev/null
unset ANTHROPIC_AUTH_TOKEN 2>/dev/null

export ANTHROPIC_BASE_URL="http://localhost:$PROXY_PORT"
export ANTHROPIC_MODEL="claude-sonnet-5"
export ANTHROPIC_SMALL_FAST_MODEL="haiku"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="1"

claude "${CLAUDE_ARGS[@]}"
