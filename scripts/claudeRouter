#!/bin/bash

# Claude Router — starts claude-code-proxy and launches Claude Code
#
# Usage:
#   claudeRouter [args...]                     → normal mode (reuses existing proxy)
#   claudeRouter --swarm                       → swarm mode (host-based claude-swarm)
#   claudeRouter --swarm --off                 → stop swarm services + proxy
#   claudeRouter --swarm --status              → show swarm status

PROXY_DIR="/Users/ibrahimalnutayfi/Desktop/Desktop - Ibrahim MAC/Tools/claude-code-proxy"
CLOUDE_FLOW_DIR="/Users/ibrahimalnutayfi/Desktop/Desktop - Ibrahim MAC/Tools/Cloude-flow"
PROXY_PORT=18765
ZAI_ENV_FILE="$HOME/.config/claude-router/.env"

# Initialize rbenv if available (needed for claude-swarm)
if [ -d "$HOME/.rbenv/shims" ]; then
  export PATH="$HOME/.rbenv/shims:$PATH"
  eval "$(rbenv init - bash 2>/dev/null)" || true
fi

# ── Parse flags ──
SWARM_MODE=false
SWARM_OFF=false
SWARM_STATUS=false
CLAUDE_ARGS=()
for arg in "$@"; do
  case "$arg" in
    --swarm)   SWARM_MODE=true ;;
    --off)     SWARM_OFF=true ;;
    --status)  SWARM_STATUS=true ;;
    *)         CLAUDE_ARGS+=("$arg") ;;
  esac
done

# ── Load ZAI key if available ──
ZAI_API_KEY=""
if [ -f "$ZAI_ENV_FILE" ]; then
  ZAI_API_KEY=$(grep '^ZAI_API_KEY=' "$ZAI_ENV_FILE" 2>/dev/null | cut -d= -f2-)
fi

# ═══════════════════════════════════════════════════════════════
# SWARM STATUS
# ═══════════════════════════════════════════════════════════════
if [ "$SWARM_STATUS" = true ]; then
  echo "┌─────────────────────────────────────┐"
  echo "│        Swarm Status                 │"
  echo "├─────────────────────────────────────┤"

  if lsof -i:$PROXY_PORT >/dev/null 2>&1; then
    PID=$(lsof -t -i:$PROXY_PORT 2>/dev/null)
    echo "│ Proxy:     RUNNING (PID $PID)       │"
  else
    echo "│ Proxy:     STOPPED                  │"
  fi

  if docker-compose -f "$CLOUDE_FLOW_DIR/docker-compose.yml" -f "$CLOUDE_FLOW_DIR/docker-compose.proxy.yml" ps 2>/dev/null | grep -q "Up"; then
    echo "│ Docker:    RUNNING                  │"
  else
    echo "│ Docker:    STOPPED                  │"
  fi

  echo "└─────────────────────────────────────┘"
  exit 0
fi

# ═══════════════════════════════════════════════════════════════
# SWARM OFF
# ═══════════════════════════════════════════════════════════════
if [ "$SWARM_OFF" = true ]; then
  echo "Stopping swarm..."
  cd "$CLOUDE_FLOW_DIR" || exit 1
  docker-compose -f docker-compose.yml -f docker-compose.proxy.yml down 2>/dev/null
  kill -9 $(lsof -t -i:$PROXY_PORT 2>/dev/null) 2>/dev/null
  echo "Swarm stopped."
  exit 0
fi

# ═══════════════════════════════════════════════════════════════
# HELPER: start proxy if not already running
# ═══════════════════════════════════════════════════════════════
ensure_proxy() {
  if lsof -i:$PROXY_PORT >/dev/null 2>&1; then
    echo "Proxy already running on port $PROXY_PORT (reusing)"
    return 0
  fi

  (
    cd "$PROXY_DIR" || exit 1
    unset ANTHROPIC_API_KEY 2>/dev/null
    unset ANTHROPIC_AUTH_TOKEN 2>/dev/null
    export ZAI_API_KEY="$ZAI_API_KEY"
    export CCP_ALIAS_PROVIDER="anthropic"
    bun run src/cli.ts serve >/dev/null 2>&1 &
  )

  echo -n "Starting proxy"
  for i in {1..20}; do
    if lsof -i:$PROXY_PORT >/dev/null 2>&1; then
      echo " ✓"
      return 0
    fi
    echo -n "."
    sleep 0.25
  done
  echo " ✗ (timeout)"
  return 1
}

# ═══════════════════════════════════════════════════════════════
# SWARM ON (managed session)
# ═══════════════════════════════════════════════════════════════
if [ "$SWARM_MODE" = true ]; then
  echo "Starting swarm session..."

  # Start proxy (reuse if already running)
  ensure_proxy || exit 1

  # Verify Docker is running
  if ! docker info >/dev/null 2>&1; then
    echo ""
    echo "❌ Docker is not running. Start Docker Desktop first:"
    echo "   open -a Docker"
    exit 1
  fi

  # Start Docker services
  cd "$CLOUDE_FLOW_DIR" || exit 1
  echo "Starting Cloude-flow services..."
  docker-compose -f docker-compose.yml -f docker-compose.proxy.yml up -d

  # Run claude-swarm on the HOST (not inside the broken container)
  echo "Launching claude-swarm (press Ctrl+D or type /exit to quit)..."
  cd "$CLOUDE_FLOW_DIR/claude-swarm" || exit 1
  ANTHROPIC_BASE_URL="http://localhost:$PROXY_PORT" \
  ANTHROPIC_MODEL="sonnet" \
  ANTHROPIC_SMALL_FAST_MODEL="haiku" \
  CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="1" \
    bundle exec exe/claude-swarm

  # Stop Docker services (keep proxy running for normal terminals)
  echo ""
  echo "Stopping Cloude-flow services..."
  cd "$CLOUDE_FLOW_DIR"
  docker-compose -f docker-compose.yml -f docker-compose.proxy.yml down 2>/dev/null
  echo "Swarm stopped."

  exit 0
fi

# ═══════════════════════════════════════════════════════════════
# NORMAL MODE (supports multiple concurrent terminals)
# ═══════════════════════════════════════════════════════════════

# Reuse existing proxy — allows multiple terminals
ensure_proxy || exit 1

# Launch Claude Code from original directory
ORIGINAL_DIR="$(pwd)"
cd "$ORIGINAL_DIR"

# Clean any leaked auth vars so Claude Code uses its stored OAuth only
unset ANTHROPIC_API_KEY 2>/dev/null
unset ANTHROPIC_AUTH_TOKEN 2>/dev/null

export ANTHROPIC_BASE_URL="http://localhost:$PROXY_PORT"
export ANTHROPIC_MODEL="sonnet"
export ANTHROPIC_SMALL_FAST_MODEL="haiku"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="1"

claude "${CLAUDE_ARGS[@]}"
